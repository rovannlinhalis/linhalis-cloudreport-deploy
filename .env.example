COMPOSE_PROJECT_NAME=cloudreport-community
COMPOSE_PROFILES=database
CLOUDREPORT_IMAGE=docker.io/rovann/cloudreport:latest
PUBLIC_URL=http://localhost:8080
APP_BIND_IP=0.0.0.0
APP_PORT=8080

DATABASE_MODE=integrated
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudreport
POSTGRES_USER=cloudreport
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSL_MODE=Disable
POSTGRES_TRUST_SERVER_CERTIFICATE=false
CLOUDREPORT_CONNECTION_STRING='Host="postgres";Port=5432;Database="cloudreport";Username="cloudreport";Password="CHANGE_ME";SSL Mode=Disable;Trust Server Certificate=false'

JWT_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

STORAGE_MODE=local
BLOB_PROVIDER=Local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=cloudreport
MINIO_USE_SSL=true

LICENSE_WEBHOOK_URL=https://n8n.linhalis.com/webhook/54791385-36ab-4ecf-80ef-1ec62c29f91f
